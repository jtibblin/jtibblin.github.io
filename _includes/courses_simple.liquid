{% assign sorted_courses = site.teachings | sort: "date" | reverse %}
{% assign courses_by_term = sorted_courses | group_by: "term" %}

{% for term in courses_by_term %}
<h3 class="year">{{ term.name }}</h3>
<ul class="post-list">
  {% for course in term.items %}
  <li>
    <h5>{{ course.title }}</h5>
    <p class="text-muted">
      {{ course.institution }}
      {% if course.syllabus %}
        {% if course.institution %}·{% endif %}
        <a href="{{ course.syllabus | relative_url }}" target="_blank" rel="noopener">syllabus</a>
      {% endif %}
    </p>
  </li>
  {% endfor %}
</ul>
{% endfor %}
