{% assign courses_by_term = site.teachings | sort: "date" | reverse | group_by: "title" %}

{% for term in courses_by_term %}
<h3 class="year">{{ term.name }}</h3>
<ul class="post-list">
  {% for course in term.items %}
  <li>
    <h5>{{ course.term }}</h5>
    <p class="text-muted">
      {{ course.institution }}
      {% if course.syllabus %}
        {% if course.institution %}·{% endif %}
        <a href="{{ course.syllabus | relative_url }}" target="_blank" rel="noopener">syllabus</a>
      {% endif %}
    </p>
    {% assign description = course.content | strip %}
    {% if description != "" %}
    <details>
      <summary>description</summary>
      {{ course.content | markdownify }}
    </details>
    {% endif %}
  </li>
  {% endfor %}
</ul>
{% endfor %}
